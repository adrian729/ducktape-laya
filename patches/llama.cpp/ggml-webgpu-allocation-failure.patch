+// DTL: errors raised inside these scopes go to the scopes, not to the uncaptured-error
+// callback (which aborts), so a failed allocation can be reported to the caller.
+static void ggml_webgpu_push_error_scopes(const wgpu::Device & device) {
+    device.PushErrorScope(wgpu::ErrorFilter::Internal);
+    device.PushErrorScope(wgpu::ErrorFilter::OutOfMemory);
+    device.PushErrorScope(wgpu::ErrorFilter::Validation);
+}
+
+// DTL: pops the scopes pushed by ggml_webgpu_push_error_scopes; false if any captured an error.
+static bool ggml_webgpu_pop_error_scopes(webgpu_global_context & ctx, const char * what) {
+    bool ok = true;
+    for (int i = 0; i < 3; i++) {
+        wgpu::PopErrorScopeStatus callback_status = wgpu::PopErrorScopeStatus::Error;
+        wgpu::ErrorType           error_type      = wgpu::ErrorType::NoError;
+        std::string               callback_message;
+
+        const wgpu::WaitStatus wait_status = ctx->instance.WaitAny(
+            ctx->device.PopErrorScope(
+                wgpu::CallbackMode::AllowSpontaneous,
+                [&callback_status, &error_type, &callback_message](
+                    wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView message) {
+                    callback_status  = status;
+                    error_type       = type;
+                    callback_message = std::string(message);
+                }),
+            WEBGPU_RUNTIME_WAIT_TIMEOUT_NS);
+
+        ggml_backend_webgpu_check_wait_status(wait_status, callback_status, wgpu::PopErrorScopeStatus::Success,
+                                              "Error scope wait", "Error scope", callback_message.c_str());
+        if (error_type != wgpu::ErrorType::NoError) {
+            if (ok) {
+                GGML_LOG_ERROR("ggml_webgpu: %s failed (error type %d): %s\n", what, static_cast<int>(error_type),
+                               callback_message.c_str());
+            }
+            ok = false;
+        }
+    }
+    return ok;
+}
