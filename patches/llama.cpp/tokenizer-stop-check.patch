+// DTL: a stop check the caller may set around llama_tokenize on its thread. Long tokenization
+// calls it periodically and stops by throwing std::runtime_error, which llama_tokenize
+// propagates; no tokenizer state outlives the call.
+static thread_local bool (*dtl_tokenize_stop)(void *) = nullptr;
+static thread_local void * dtl_tokenize_stop_data = nullptr;
+extern "C" void dtl_llama_tokenize_set_stop(bool (*stop)(void *), void * data);
+extern "C" void dtl_llama_tokenize_set_stop(bool (*stop)(void *), void * data) {
+    dtl_tokenize_stop = stop;
+    dtl_tokenize_stop_data = data;
+}
+static void dtl_tokenize_check_now() {
+    if (dtl_tokenize_stop && dtl_tokenize_stop(dtl_tokenize_stop_data)) {
+        throw std::runtime_error("tokenization stopped");
+    }
+}
+// checks once every 1024 calls
+static inline void dtl_tokenize_check(uint32_t & counter) {
+    if (dtl_tokenize_stop && (++counter & 1023) == 0) {
+        dtl_tokenize_check_now();
+    }
+}
