 #include <set>
 #include <unordered_map>
 
+// DTL: a stop check the caller may set around llama_tokenize on its thread. Tokenization
+// counts its work (words, bigram insertions, merges, special-token passes and matches, and
+// the text the special-token search scans) in one counter per thread, which setting a check
+// where there was none resets, and calls the check once per 1024 units. When it reports a stop, tokenization throws
+// dtl_tokenize_stopped, which llama_vocab::tokenize turns into a return value before the C API
+// (llama_tokenize returns DTL_LLAMA_TOKENIZE_STOPPED); no tokenizer state outlives the call.
+struct dtl_tokenize_stopped {};
+static thread_local bool (*dtl_tokenize_stop)(void *) = nullptr;
+static thread_local void * dtl_tokenize_stop_data = nullptr;
+static thread_local uint32_t dtl_tokenize_work = 0;
+// Swaps this thread's check with *stop/*data (null: none), so the caller can restore the
+// previous one. Setting a check where there was none restarts the work count; replacing one
+// check with another (a nested call's, and the restore after it) keeps counting.
+extern "C" void dtl_llama_tokenize_swap_stop(bool (**stop)(void *), void ** data);
+extern "C" void dtl_llama_tokenize_swap_stop(bool (**stop)(void *), void ** data) {
+    if (!dtl_tokenize_stop && *stop) {
+        dtl_tokenize_work = 0;
+    }
+    std::swap(dtl_tokenize_stop, *stop);
+    std::swap(dtl_tokenize_stop_data, *data);
+}
+// llama_tokenize results that are not -n_tokens: a stop, a failed allocation and any other
+// exception (the most negative -n_tokens is INT32_MIN + 5; INT32_MIN reports an overflow).
+#define DTL_LLAMA_TOKENIZE_STOPPED   (std::numeric_limits<int32_t>::min() + 1)
+#define DTL_LLAMA_TOKENIZE_NO_MEMORY (std::numeric_limits<int32_t>::min() + 2)
+#define DTL_LLAMA_TOKENIZE_FAILED    (std::numeric_limits<int32_t>::min() + 3)
+// counts units of work; checks once every 1024
+static inline void dtl_tokenize_check(size_t units = 1) {
+    if (dtl_tokenize_stop) {
+        dtl_tokenize_work += units > 1024 ? 1024 : static_cast<uint32_t>(units);
+        if (dtl_tokenize_work >= 1024) {
+            dtl_tokenize_work = 0;
+            if (dtl_tokenize_stop(dtl_tokenize_stop_data)) {
+                throw dtl_tokenize_stopped();
+            }
+        }
+    }
+}
