+// DTL: the question type whose head the next graph on this thread evaluates (0 choice, 1 score,
+// 2 noul), or -1 for all three. Set by ducktape-laya around llama_encode; not exported.
+static thread_local int dtl_decision_type = -1;
+extern "C" void dtl_laya_select_decision_type(int type);
+extern "C" void dtl_laya_select_decision_type(int type) { dtl_decision_type = type; }
+namespace {
+// DTL: no tensors; a graph is reused only for the selection it was built for.
+class dtl_decision_type_input : public llm_graph_input_i {
+public:
+    explicit dtl_decision_type_input(int selected) : type(selected) {}
+    void set_input(const llama_ubatch *) override {}
+    bool can_reuse(const llm_graph_params &) override { return type == dtl_decision_type; }
+private:
+    const int type;
+};
+}
