<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DucktapeLaya</PackageId>
    <Version>0.2.0</Version>
    <RootNamespace>Ducktape.Laya</RootNamespace>
    <AssemblyName>DucktapeLaya</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Local Laya GGUF decisions (choice, noul, score) through the bundled ducktape-laya native library.</Description>
    <Authors>adrian729</Authors>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adrian729/ducktape-laya</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adrian729/ducktape-laya</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>laya;gguf;llama.cpp;classification;decisions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../../licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DucktapeLaya.Tests" />
  </ItemGroup>
  <!-- The native library at runtimes/<rid>/native/ under its own file name: libducktape_laya.so (linux-x64,
       linux-arm64), libducktape_laya.dylib (osx-arm64) or ducktape_laya.dll (win-x64). -->
  <PropertyGroup>
    <DucktapeLayaRuntime Condition="'$(DucktapeLayaRuntime)' == ''">linux-x64</DucktapeLayaRuntime>
    <DucktapeLayaNativeFile>$([System.IO.Path]::GetFileName('$(DucktapeLayaNativeLibrary)'))</DucktapeLayaNativeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(DucktapeLayaNativeLibrary)' != ''">
    <None Include="$(DucktapeLayaNativeLibrary)" Pack="true" PackagePath="runtimes/$(DucktapeLayaRuntime)/native/$(DucktapeLayaNativeFile)" Link="runtimes/$(DucktapeLayaRuntime)/native/$(DucktapeLayaNativeFile)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
