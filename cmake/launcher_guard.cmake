# Compiler launchers. The library and the Node addon must compile through exactly the launcher
# of CMAKE_<LANG>_COMPILER_LAUNCHER (none for release evidence), because a cache that rewrites
# paths (ccache base_dir) changes their bytes. DUCKTAPE_REFERENCE_PROBE_LAUNCHER gives one only
# to the targets the developer reference probe alone compiles (they never reach a shipped
# binary). Checked here over the transitive link closure, not a list of names, and written to
# generated/launcher-guard.json for the validation report.

# The targets in the link closure of the given targets (LINK_LIBRARIES and INTERFACE_LINK_LIBRARIES,
# $<LINK_ONLY:...> unwrapped, aliases resolved); imported targets compile nothing and are left out.
function(dtl_link_closure out)
  set(pending ${ARGN})
  set(seen)
  while(pending)
    list(POP_FRONT pending target)
    if(NOT TARGET "${target}")
      continue()
    endif()
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if(aliased)
      set(target "${aliased}")
    endif()
    get_target_property(imported "${target}" IMPORTED)
    if(imported OR target IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${target}")
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(links "${target}" ${property})
      foreach(link IN LISTS links)
        if(link MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
          set(link "${CMAKE_MATCH_1}")
        endif()
        if(NOT link MATCHES "^\\$<" AND TARGET "${link}")
          list(APPEND pending "${link}")
        endif()
      endforeach()
    endforeach()
  endwhile()
  list(SORT seen)
  set(${out} "${seen}" PARENT_SCOPE)
endfunction()

function(dtl_json_string out text)
  string(REPLACE "\\" "\\\\" text "${text}")
  string(REPLACE "\"" "\\\"" text "${text}")
  set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

set(DTL_PRODUCT_ROOTS ducktape_laya ${DTL_OBJECT_LIBRARIES})
foreach(target ducktape_laya_node ducktape_laya_wasm)
  if(TARGET ${target})
    list(APPEND DTL_PRODUCT_ROOTS ${target})
  endif()
endforeach()
dtl_link_closure(DTL_PRODUCT_TARGETS ${DTL_PRODUCT_ROOTS})

set(DTL_PROBE_ONLY_TARGETS)
if(TARGET laya-reference)
  dtl_link_closure(probe_closure laya-reference)
  foreach(target IN LISTS probe_closure)
    if(NOT target IN_LIST DTL_PRODUCT_TARGETS)
      list(APPEND DTL_PROBE_ONLY_TARGETS ${target})
    endif()
  endforeach()
  if(NOT "${DUCKTAPE_REFERENCE_PROBE_LAUNCHER}" STREQUAL "")
    foreach(target IN LISTS DTL_PROBE_ONLY_TARGETS)
      set_target_properties(${target} PROPERTIES C_COMPILER_LAUNCHER "${DUCKTAPE_REFERENCE_PROBE_LAUNCHER}"
        CXX_COMPILER_LAUNCHER "${DUCKTAPE_REFERENCE_PROBE_LAUNCHER}")
    endforeach()
  endif()
elseif(NOT "${DUCKTAPE_REFERENCE_PROBE_LAUNCHER}" STREQUAL "")
  message(FATAL_ERROR "DUCKTAPE_REFERENCE_PROBE_LAUNCHER needs DUCKTAPE_BUILD_REFERENCE_PROBE=ON")
endif()

# A rule launcher applies to every target, whatever its launcher properties (ggml's GGML_CCACHE
# sets the global one): refused, use CMAKE_<LANG>_COMPILER_LAUNCHER instead.
foreach(scope GLOBAL DIRECTORY)
  foreach(rule RULE_LAUNCH_COMPILE RULE_LAUNCH_LINK)
    get_property(value ${scope} PROPERTY ${rule})
    if(NOT "${value}" STREQUAL "")
      message(FATAL_ERROR "The ${scope} property ${rule} is set (\"${value}\"): it would launch the library's compiler "
        "too. Configure with -DGGML_CCACHE=OFF and use CMAKE_<LANG>_COMPILER_LAUNCHER for a compiler cache.")
    endif()
  endforeach()
endforeach()
foreach(target IN LISTS DTL_PRODUCT_TARGETS)
  foreach(lang C CXX)
    get_target_property(launcher ${target} ${lang}_COMPILER_LAUNCHER)
    if(NOT launcher)
      set(launcher "")
    endif()
    if(NOT "${launcher}" STREQUAL "${CMAKE_${lang}_COMPILER_LAUNCHER}")
      message(FATAL_ERROR "${target} compiles ${lang} through the launcher \"${launcher}\", not "
        "CMAKE_${lang}_COMPILER_LAUNCHER (\"${CMAKE_${lang}_COMPILER_LAUNCHER}\"): it is part of the library or addon")
    endif()
  endforeach()
endforeach()

set(DTL_LAUNCHER_GUARD "{}")
set(items "")
foreach(target IN LISTS DTL_PRODUCT_TARGETS)
  dtl_json_string(item "${target}")
  list(APPEND items "${item}")
endforeach()
list(JOIN items ", " items)
string(JSON DTL_LAUNCHER_GUARD SET "${DTL_LAUNCHER_GUARD}" product_targets "[${items}]")
set(probe "{}")
foreach(target IN LISTS DTL_PROBE_ONLY_TARGETS)
  get_target_property(launcher ${target} CXX_COMPILER_LAUNCHER)
  if(launcher)
    dtl_json_string(value "${launcher}")
    string(JSON probe SET "${probe}" "${target}" "${value}")
  endif()
endforeach()
string(JSON DTL_LAUNCHER_GUARD SET "${DTL_LAUNCHER_GUARD}" probe_targets "${probe}")
string(JSON DTL_LAUNCHER_GUARD SET "${DTL_LAUNCHER_GUARD}" rule_launch "\"\"")
dtl_write_if_changed("${CMAKE_CURRENT_BINARY_DIR}/generated/launcher-guard.json" "${DTL_LAUNCHER_GUARD}\n")
