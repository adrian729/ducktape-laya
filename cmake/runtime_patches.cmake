# Apply audited patches to build-directory copies; never mutate the submodule.
# Patchable upstream sources and the target compiling each. The WASM kernels are
# compiled only when upstream selects them (CMAKE_SYSTEM_PROCESSOR matches wasm).
# Patched headers are used through DTL_VENDOR_INCLUDE, ahead of upstream's copy.
set(DTL_PATCH_ROOT "${CMAKE_CURRENT_BINARY_DIR}/runtime-patched")
set(DTL_PATCHED_FILES ggml/src/ggml.c ggml/src/ggml-alloc.c ggml/src/ggml-backend.cpp ggml/src/ggml-cpu/ggml-cpu.c
  ggml/src/ggml-cpu/arch/wasm/quants.c common/json.cpp common/jinja/runtime.cpp common/jinja/value.cpp)
set(DTL_PATCHED_TARGETS ggml-base ggml-base ggml-base ggml-cpu ggml-cpu ducktape_laya ducktape_laya ducktape_laya)
set(DTL_PATCHED_REQUIRED ON ON ON ON OFF ON ON ON)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "wasm")
  set(DTL_PATCHED_REQUIRED ON ON ON ON ON ON ON ON)
endif()
set(DTL_PATCHED_HEADERS vendor/nlohmann/json.hpp)
set(DTL_VENDOR_INCLUDE "${DTL_PATCH_ROOT}/vendor")
find_program(DTL_PATCH_EXECUTABLE patch REQUIRED)
foreach(path IN LISTS DTL_PATCHED_FILES DTL_PATCHED_HEADERS)
  configure_file("${UPSTREAM}/${path}" "${DTL_PATCH_ROOT}/${path}" COPYONLY)
endforeach()
string(JSON DTL_PATCH_COUNT LENGTH "${DTL_RELEASE_RECORD}" runtime patches)
if(DTL_PATCH_COUNT GREATER 0)
  math(EXPR DTL_PATCH_LAST "${DTL_PATCH_COUNT} - 1")
  foreach(index RANGE ${DTL_PATCH_LAST})
    string(JSON path GET "${DTL_RELEASE_RECORD}" runtime patches ${index} path)
    string(JSON expected GET "${DTL_RELEASE_RECORD}" runtime patches ${index} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Runtime patch hash mismatch: ${path}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${path}")
    execute_process(COMMAND "${DTL_PATCH_EXECUTABLE}" --batch --forward --fuzz=0 -p1
      -d "${DTL_PATCH_ROOT}" -i "${CMAKE_CURRENT_SOURCE_DIR}/${path}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Runtime patch conflict: ${path}\n${output}\n${error}")
    endif()
  endforeach()
endif()

# Replace a target's upstream sources with their patched copies. Each required file
# must be replaced exactly once in its own target and nowhere else; otherwise the
# upstream layout changed and patch integration needs review.
function(dtl_use_patched_sources target)
  get_target_property(source_dir ${target} SOURCE_DIR)
  get_target_property(sources ${target} SOURCES)
  set(replaced)
  set(found)
  foreach(source IN LISTS sources)
    if(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
      set(absolute "${source}")
    else()
      get_filename_component(absolute "${source_dir}/${source}" ABSOLUTE)
    endif()
    foreach(path IN LISTS DTL_PATCHED_FILES)
      if(absolute STREQUAL "${UPSTREAM}/${path}")
        set(absolute "${DTL_PATCH_ROOT}/${path}")
        list(APPEND found "${path}")
      endif()
    endforeach()
    list(APPEND replaced "${absolute}")
  endforeach()
  set_property(TARGET ${target} PROPERTY SOURCES "${replaced}")
  # Copies keep upstream's quoted relative includes (e.g. ../../quants.h) resolving
  # against their original directory; only patched sources are copied. -iquote
  # keeps that directory's headers (e.g. jinja/string.h) from shadowing <string.h>.
  foreach(path IN LISTS found)
    get_filename_component(original_dir "${UPSTREAM}/${path}" DIRECTORY)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      set_source_files_properties("${DTL_PATCH_ROOT}/${path}" TARGET_DIRECTORY ${target}
        PROPERTIES COMPILE_OPTIONS "-iquote;${original_dir}")
    else()
      set_source_files_properties("${DTL_PATCH_ROOT}/${path}" TARGET_DIRECTORY ${target}
        PROPERTIES INCLUDE_DIRECTORIES "${original_dir}")
    endif()
  endforeach()
  list(LENGTH DTL_PATCHED_FILES count)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    list(GET DTL_PATCHED_FILES ${index} path)
    list(GET DTL_PATCHED_TARGETS ${index} owner)
    list(GET DTL_PATCHED_REQUIRED ${index} required)
    set(matches 0)
    foreach(item IN LISTS found)
      if(item STREQUAL path)
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
    set(expected 0)
    if(owner STREQUAL target AND required)
      set(expected 1)
    endif()
    if(NOT matches EQUAL expected)
      message(FATAL_ERROR "Runtime source layout changed for ${target}: ${path} found ${matches} times, expected ${expected}; patch integration requires review")
    endif()
  endforeach()
endfunction()
dtl_use_patched_sources(ggml-base)
dtl_use_patched_sources(ggml-cpu)
