# Apply audited patches to build-directory copies; never mutate the submodule.
string(JSON DTL_PATCH_COUNT LENGTH "${DTL_RELEASE_RECORD}" runtime patches)
if(DTL_PATCH_COUNT GREATER 0)
  find_program(DTL_PATCH_EXECUTABLE patch REQUIRED)
  set(DTL_PATCH_ROOT "${CMAKE_CURRENT_BINARY_DIR}/runtime-patched")
  foreach(path ggml/src/ggml.c ggml/src/ggml-cpu/ggml-cpu.c)
    configure_file("${UPSTREAM}/${path}" "${DTL_PATCH_ROOT}/${path}" COPYONLY)
  endforeach()
  math(EXPR DTL_PATCH_LAST "${DTL_PATCH_COUNT} - 1")
  foreach(index RANGE ${DTL_PATCH_LAST})
    string(JSON path GET "${DTL_RELEASE_RECORD}" runtime patches ${index} path)
    string(JSON expected GET "${DTL_RELEASE_RECORD}" runtime patches ${index} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Runtime patch hash mismatch: ${path}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${path}")
    execute_process(COMMAND "${DTL_PATCH_EXECUTABLE}" --batch --forward --fuzz=0 -p1
      -d "${DTL_PATCH_ROOT}" -i "${CMAKE_CURRENT_SOURCE_DIR}/${path}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Runtime patch conflict: ${path}\n${output}\n${error}")
    endif()
  endforeach()
  foreach(target ggml-base ggml-cpu)
    get_target_property(source_dir ${target} SOURCE_DIR)
    get_target_property(sources ${target} SOURCES)
    set(replaced)
    set(replaced_count 0)
    foreach(source IN LISTS sources)
      if(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
        set(absolute "${source}")
      else()
        get_filename_component(absolute "${source_dir}/${source}" ABSOLUTE)
      endif()
      if(absolute STREQUAL "${UPSTREAM}/ggml/src/ggml.c")
        set(absolute "${DTL_PATCH_ROOT}/ggml/src/ggml.c")
        math(EXPR replaced_count "${replaced_count} + 1")
      elseif(absolute STREQUAL "${UPSTREAM}/ggml/src/ggml-cpu/ggml-cpu.c")
        set(absolute "${DTL_PATCH_ROOT}/ggml/src/ggml-cpu/ggml-cpu.c")
        math(EXPR replaced_count "${replaced_count} + 1")
      endif()
      list(APPEND replaced "${absolute}")
    endforeach()
    if(NOT replaced_count EQUAL 1)
      message(FATAL_ERROR "Runtime source layout changed for ${target}; patch integration requires review")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${replaced}")
  endforeach()
endif()
