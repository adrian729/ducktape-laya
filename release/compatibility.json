    "patches": [
      {
        "path": "patches/llama.cpp/typed-cpu-callbacks.patch",
        "sha256": "f078d54edda1b4ae64d77025d58408eb66778d7880f0b7088bbed2e08b8b2f1f",
        "purpose": "Typed callback bridges for supported Q8/F16/BF16/F32 tensor paths; no arithmetic changes"
      },
      {
        "path": "patches/llama.cpp/wasm-q8-round-to-nearest.patch",
        "sha256": "21889acaaae4240f4f1b379cd7851c579bcb318544ec1eeaf8ddcda639e8a608",
        "purpose": "WASM SIMD Q8_0/Q8_1 activation quantization rounds to nearest like the reference and x86 paths instead of truncating; browser WASM CPU arithmetic only"
      },
      {
        "path": "patches/llama.cpp/nlohmann-nothrow-destroy.patch",
        "sha256": "8f08657ba9381e4baaae3c6512c03cb50a5dba8b1fdd2ede5514a39b16a33ae9",
        "purpose": "nlohmann::json destruction falls back to recursion instead of terminating when its flattening stack cannot be allocated; no arithmetic changes"
      },
      {
        "path": "patches/llama.cpp/common-propagate-allocation-failure.patch",
        "sha256": "171ba77e176147f7112a2e99f89aee1a062e4e07c10f1466f98d4cc536b7399c",
        "purpose": "JSON parsing and Jinja rendering propagate std::bad_alloc instead of rewrapping or swallowing it; no arithmetic changes"
      },
      {
        "path": "patches/llama.cpp/ggml-check-allocations.patch",
        "sha256": "1719507fb2bf20bd2860b97de848c0ab8d9c658be74d24897dbb84e7e62328f4",
        "purpose": "ggml checks unchecked internal allocations: the CPU thread pool reports GGML_STATUS_ALLOC_FAILED, graph allocator/scheduler sites abort instead of dereferencing NULL; no arithmetic changes"
      }
    ]
  },
